{
  "name": "topple",
  "type": "module",
  "description": "",
  "repository": "",
  "author": "Brian DeVries",
  "source": "index.html",
  "license": "MIT",
  "scripts": {
    "client-dev": "parcel index.html --no-cache --port 8080 --open",
    "client-build": "parcel build index.html",
    "build": "parcel build index.html",
    "seed-dev-db": "node scripts/seed-dev-db.js",
    "server-dev": "nodemon --env-file=.env --watch server --ext js,json,html,css server/server.js",
    "dev": "concurrently \"npm run server-dev\" \"npm run client-dev\"",
    "deploy": "npm run build",
    "deploy:remote": "./scripts/deploy-remote.sh",
    "start": "node --env-file=.env server/server.js",
    "prod": "npm run start"
  },
  "dependencies": {
    "@fastify/static": "^8.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "better-sqlite3": "^11.5.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.1.0",
    "mithril": "^2.2.2",
    "parcel": "^2.12.0",
    "pino-roll": "^2.2.0"
  },
  "devDependencies": {
    "@types/mithril": "^2.2.7",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7",
    "pino-pretty": "^11.3.0"
  }
}
